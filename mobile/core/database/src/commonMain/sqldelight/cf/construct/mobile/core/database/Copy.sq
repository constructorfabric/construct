CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    time TEXT NOT NULL,
    origin TEXT NOT NULL DEFAULT 'computer'
);

-- Opaque core records include the hidden recall calls and results.
CREATE TABLE chat_record (
    conversation_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    record_json TEXT NOT NULL,
    PRIMARY KEY (conversation_id, position)
);

CREATE TABLE message (
    conversation_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    role TEXT NOT NULL,
    text TEXT NOT NULL,
    PRIMARY KEY (conversation_id, position)
);

-- The value is JSON text: a string, or an object.
CREATE TABLE fact (
    fact_id TEXT NOT NULL PRIMARY KEY,
    entity_kind TEXT NOT NULL,
    property TEXT NOT NULL,
    value_json TEXT NOT NULL,
    stored_at TEXT NOT NULL,
    tool TEXT
);

-- One row at most: the last good document and the problem of the file as it is now, both JSON text.
CREATE TABLE document (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    document_json TEXT,
    problem_json TEXT
);

-- The key is the JSON text of the input the numbers were counted for.
CREATE TABLE numbers (
    input_json TEXT NOT NULL PRIMARY KEY,
    numbers_json TEXT NOT NULL
);

-- One row at most: when the copy was last brought up to date and what it was brought up to date from. `computer` is
-- the fingerprint of the certificate of the computer the copy came from, `reset_marker` the marker of its last
-- erasure that the copy has seen, each token the one the computer gave for that part when the part was last copied,
-- and `zone` the time zone of the computer's days. `first_copy_done` is 1 once a whole first copy from `computer`
-- has been made.
CREATE TABLE sync (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    synced_at TEXT,
    memory_version INTEGER,
    computer TEXT,
    reset_marker TEXT,
    facts_token TEXT,
    chats_token TEXT,
    dashboard_token TEXT,
    zone TEXT,
    first_copy_done INTEGER NOT NULL DEFAULT 0
);

listConversations:
SELECT id, title, time, origin,
    COALESCE((SELECT text FROM message WHERE conversation_id = conversation.id AND role != 'TOOL'
        ORDER BY position DESC LIMIT 1), '') AS preview
FROM conversation;

conversationExists:
SELECT COUNT(*) FROM conversation WHERE id = ?;

conversationOrigin:
SELECT origin FROM conversation WHERE id = ?;

setConversationOrigin:
UPDATE conversation SET origin = ? WHERE id = ?;

phoneConversations:
SELECT id FROM conversation WHERE origin = 'phone';

computerConversations:
SELECT id FROM conversation WHERE origin = 'computer';

updateConversationTime:
UPDATE conversation SET time = ? WHERE id = ?;

recordsOf:
SELECT record_json FROM chat_record WHERE conversation_id = ? ORDER BY position;

saveRecord:
INSERT INTO chat_record(conversation_id, position, record_json) VALUES (?, ?, ?);

deleteRecordsOf:
DELETE FROM chat_record WHERE conversation_id = ?;

deleteAllRecords:
DELETE FROM chat_record;

messagesOf:
SELECT role, text FROM message WHERE conversation_id = ? ORDER BY position;

saveConversation:
INSERT OR IGNORE INTO conversation(id, title, time) VALUES (?, ?, ?);

updateConversation:
UPDATE conversation SET title = ?, time = ? WHERE id = ?;

saveMessage:
INSERT INTO message(conversation_id, position, role, text) VALUES (?, ?, ?, ?);

deleteMessagesOf:
DELETE FROM message WHERE conversation_id = ?;

deleteConversation:
DELETE FROM conversation WHERE id = ?;

deleteAllMessages:
DELETE FROM message;

deleteAllConversations:
DELETE FROM conversation;

listFacts:
SELECT fact_id, entity_kind, property, value_json, stored_at, tool FROM fact ORDER BY rowid;

saveFact:
INSERT OR REPLACE INTO fact(fact_id, entity_kind, property, value_json, stored_at, tool) VALUES (?, ?, ?, ?, ?, ?);

deleteAllFacts:
DELETE FROM fact;

documentRow:
SELECT document_json, problem_json FROM document WHERE id = 1;

saveDocument:
INSERT OR REPLACE INTO document(id, document_json, problem_json) VALUES (1, ?, ?);

deleteDocument:
DELETE FROM document;

numbersFor:
SELECT numbers_json FROM numbers WHERE input_json = ?;

saveNumbers:
INSERT OR REPLACE INTO numbers(input_json, numbers_json) VALUES (?, ?);

deleteAllNumbers:
DELETE FROM numbers;

lastSync:
SELECT synced_at FROM sync WHERE id = 1;

startSync:
INSERT OR IGNORE INTO sync(id) VALUES (1);

saveSyncedAt:
UPDATE sync SET synced_at = ? WHERE id = 1;

memoryVersion:
SELECT memory_version FROM sync WHERE id = 1;

saveMemoryVersion:
UPDATE sync SET memory_version = ? WHERE id = 1;

deleteSync:
DELETE FROM sync;

readSync:
SELECT computer, reset_marker, facts_token, chats_token, dashboard_token, zone, first_copy_done, synced_at
FROM sync WHERE id = 1;

saveComputer:
UPDATE sync SET computer = ? WHERE id = 1;

saveResetMarker:
UPDATE sync SET reset_marker = ? WHERE id = 1;

saveFactsToken:
UPDATE sync SET facts_token = ? WHERE id = 1;

saveChatsToken:
UPDATE sync SET chats_token = ? WHERE id = 1;

saveDashboardToken:
UPDATE sync SET dashboard_token = ?, zone = ? WHERE id = 1;

saveFirstCopyDone:
UPDATE sync SET first_copy_done = 1 WHERE id = 1;

forgetResetMarker:
UPDATE sync SET reset_marker = NULL WHERE id = 1;

computerChats:
SELECT conversation.id, conversation.title,
    (SELECT COUNT(*) FROM message WHERE conversation_id = conversation.id) AS items
FROM conversation WHERE origin = 'computer';

messageCount:
SELECT COUNT(*) FROM message WHERE conversation_id = ?;

updateConversationTitle:
UPDATE conversation SET title = ? WHERE id = ?;

-- Read for the tables it names, not for its answer: a change signal for the dashboard.
dashboardMarks:
SELECT (SELECT COUNT(*) FROM numbers), (SELECT COUNT(*) FROM document);

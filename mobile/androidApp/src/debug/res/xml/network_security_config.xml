<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: it also trusts the page tests' certificate. See the README, "The Glasshouse page on Android". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/glasshouse_test_certificate" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain http stays blocked. The debug build alone also trusts the certificate of the page tests' server, which
  the build makes for itself; `debug-overrides` is ignored by an app that is not debuggable.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/glasshouse_test_certificate" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
